{% extends 'base.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block body %}

{% block nav %}
        <nav class="menu">
            <img src="{{ asset('img/icons/shop.svg') }}" class="icon icon--logo" alt="Logo de Shop manager" />
            <ul class="list">
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="{{ asset('img/icons/dashboard.png') }}" class="icon" alt="Tableau de bord"/>
                    Tableau de bord</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="{{ asset('img/icons/users.svg') }}" class="icon" alt="Clients"/>
                    Clients</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="{{ asset('img/icons/order.png') }}" class="icon" alt="Commandes"/>
                    Commandes</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="{{ asset('img/icons/product.png') }}" class="icon" alt="Produits"/>
                    Produits</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="{{ asset('img/icons/star.svg') }}" class="icon" alt="Fidélité"/>
                    Fidélité</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="{{ asset('img/icons/settings.png') }}" class="icon" alt="Paramètres"/>
                    Paramètres</a>
                </li>
            </ul>
            <div class="bottom">
                <figure class="user">
                    <img src="{{ asset('img/icons/user.svg') }}" class="icon icon--avatar" alt="Avatar de l'utilisateur" />
                </figure>
                <a href="/" class="link link--error" target="">Déconnexion</a>
                <div class="identity">
                    <p class="corps">Jean DUPONT<br>À COMPLÉTER</p>
                    <p class="corps">Administrateur<br>À COMPLÉTER</p>
                </div>
                <img src="{{ asset('img/icons/dropdown.svg') }}" class="icon" alt="Icône de descente vers le bas" />
            </div>
        </nav>
{% endblock %}

<main class="clients">
{% block header %}
<header class="header">
    <div class="left">
        <h1 class="title">Clients</h1>
        <p class="corps corps--little">Gérez et consultez la liste de vos clients.</p>
    </div>
    <div class="btns">
        <a href="{{ path('admin_clients_export') }}" class="btn">
            <img src="{{ asset('img/icons/export.svg') }}" class="icon" alt="Icône d'export"/>
            Exporter
        </a>
        <a href="" class="btn btn--secondary">
            <img src="{{ asset('img/icons/addUser.svg') }}" class="icon" alt="Icône d'ajout d'un utilisateur"/>
            Nouveau client
        </a>
    </div>
</header>
{% endblock %}

{% block filters %}
<form method="get" class="filters">

    <input
        type="search"
        name="search"
        value="{{ app.request.query.get('search') }}"
        placeholder="Nom, prénom, email ..."
        class="filter filter--text"
    >

    <select name="newsletter" class="filter filter--select">
        <option value="">Newsletter</option>
        <option value="oui" {{ app.request.query.get('newsletter') == 'oui' ? 'selected' : '' }}>
            Oui
        </option>
        <option value="non" {{ app.request.query.get('newsletter') == 'non' ? 'selected' : '' }}>
            Non
        </option>
    </select>

    <select name="city" class="filter filter--select">
        <option value="">Ville</option>

        {% for city in cities %}
        <option
            value="{{ city }}"
            {{ app.request.query.get('city') == city ? 'selected' : '' }}
        >
            {{ city }}
        </option>
        {% endfor %}
    </select>

    <select name="limit" class="filter filter--select">
        {% for limit in allowedLimits %}
            <option
                value="{{ limit }}"
                {{ app.request.query.getInt('limit', 10) == limit ? 'selected' : '' }}
            >
                {{ limit }} par page
            </option>
        {% endfor %}
    </select>

    <button type="submit">
        Rechercher
    </button>

    <a href="">
        Réinitialiser
    </a>

</form>
{% endblock %}

{% block statistics %}
<div class="statistics">
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/users.svg') }}" alt="Icône d'utilisateur" class="icon">
        </span>
        <div class="legend">
            <p class="name">Total des clients</p>
            <p class="number">{{ totalClients }}</p>
            <p class="percent">+{{ newClients }} ce mois</p>
        </div>
    </figure>
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/star.svg') }}" alt="Icône d'une étoile" class="icon">
        </span>
        <div class="legend">
            <p class="name">Clients fidèles</p>
            <p class="number">{{ loyalClients }}</p>
            <p class="percent">{{ percentClient|number_format(2, ',', ' ') }} % du total</p>
    </figure>
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/gift.svg') }}" alt="Icône d'un cadeau" class="icon">
        </span>
        <div class="legend">
            <p class="name">Points émis</p>
            <p class="number">{{ loyalty }}</p>
            <p class="percent">+ {{ thisMonth|number_format(2, ',', ' ') }} ce mois</p>
        </div>
    </figure>
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/calendar.svg') }}" alt="Icône d'un calendrier" class="icon">
        </span>
        <div class="legend">
            <p class="name">Total des achats</p>
            <p class="number">{{ totalSales }} €</p>
            <p class="percent">+ {{ salesThisMonth }} € ce mois</p>
        </div>
    </figure>
</div>
{% endblock %}

{% block list %}
<section class="array__container">
<table class="array">
    <tr class="names">
        <th class="name">Client</th>
        <th class="name">Carte fidélité</th>
        <th class="name">Solde de points</th>
        <th class="name">Dernière commande</th>
        <th class="name">Total des achats</th>
        <th class="name">Newsletter</th>
        <th class="name">Statut</th>
        <th class="name">Actions</th>
        <th class="name"></th>
    </tr>
{% for row in clients %}
    {% set client = row[0] %}
    {% set lastBuy = row.lastBuy %}
    {% set allBuys = row.allBuys %}
    <tr class="line">
        <th class="box identity">
            <p class="initial initial--{{ client.nom|slice(0,1)|lower }}">{{ client.nom|slice(0,1)|upper }}{{ client.prenom|slice(0,1)|upper }}</p>
            <div class="part">
                <p class="corps">{{ client.prenom }} {{ client.nom }}</p>
                <p class="corps corps--second">{{ client.email }}</p>
            </div>
        </th>
        <th class="box">
            <p class="corps">#{{ client.carteFidelite.id }}</p>
        </th>
        <th class="box">
            <p class="corps">{{ client.carteFidelite.soldePoints }}</p>
        </th>
        
        <th class="box">
            <p class="corps">
            {% if allBuys is null %}
                -
            {% else %}
                {{ allBuys|number_format(2, '.', '') }} €
            {% endif %}
            </p>
        </th>
        <th class="box">
        
            <p class="corps">
            {% if lastBuy is null %}
                -
            {% else %}
                {{ lastBuy|date('d/m/Y') }}
            {% endif %}
            </p> 
        </th>
        <th class="box">
        {% if client.newsletter == 1 %}
            <p class="tag tag--success">Oui</p>
        {% else %}
            <p class="tag tag--error">Non</p>
        {% endif %}
        </th>
        <th class="box">
        {% if client.statut == 'fidele' %}
            <p class="tag tag--primary">Client fidèle</p>
        {% elseif client.statut == 'regulier' %}
            <p class="tag tag--secondary">Client régulier</p>
        {% elseif client.statut == 'nouveau' %}
            <p class="tag tag--secondary">Nouveau</p>
        {% else %}
            <p class="tag tag--warning">À développer</p>
        {% endif %}
        </th>
        <th class="box box--icon">
            <img src="{{ asset('img/icons/eye.svg') }}" alt="Voir plus" class="icon">
        </th>
        <th class="box box--icon">
            <img src="{{ asset('img/icons/etc.svg') }}" alt="Actions rapides" class="icon">
        </th>
    </tr>
{% endfor %} 
</table>
</section>
{% endblock %}

{% block pagination %}

{% set totalItems = clients.getTotalItemCount %}

{% if (clients.getCurrentPageNumber() * pageLimit) >= totalItems %}
   {% set maxItem = totalItems %}
{% else %}
    {% set maxItem = clients.getCurrentPageNumber() * pageLimit %}
{% endif %}

<div class="pagination">
    <p class="corps">Affichage {{ (clients.getCurrentPageNumber - 1) * pageLimit }} à {{ maxItem }} sur {{ (totalItems / pageLimit)|round(0, 'ceil') }} pages</p>
    {{ knp_pagination_render(clients) }}
</div>
{% endblock %}
</main>
{% endblock %}
