{% extends 'base.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block body %}

{% block nav %}
        <nav class="menu">
            <img src="" class="logo" alt="Logo de Shop manager" />
            <ul class="list">
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="" class="icon" alt="Icône"/>
                    Tableau de bord</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="" class="icon" alt="Icône"/>
                    Clients</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="" class="icon" alt="Icône"/>
                    Commandes</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="" class="icon" alt="Icône"/>
                    Produits</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="" class="icon" alt="Icône"/>
                    Fidélité</a>
                </li>
                <li class="item">
                    <a href="" class="link" target="">
                    <img src="" class="icon" alt="Icône"/>
                    Paramètres</a>
                </li>
            </ul>
            <div class="bottom">
                <figure class="user">
                    <img src="" class="avatar" alt="Avatar de l'utilisateur" />
                </figure>
                <a href="/" class="link link--error" target="">Déconnexion</a>
            </div>
        </nav>
{% endblock %}

<main class="clients">
{% block header %}
<header class="header">
    <div class="left">
        <h1 class="title">Clients</h1>
        <div class="corps">
            <p>Gérez et consultez la liste de vos clients.</p>
        </div>
    </div>
    <div class="right">
        <p class="btn">
            <img src="" class="icon" alt="Icône"/>
            Exporter
        </p>
        <a href="" class="btn btn--secondary">
            <img src="" class="icon" alt="Icône"/>
            Nouveau client
        </a>
    </div>
</header>
{% endblock %}

{% block filters %}
<div class="filters">
    <form method="get">
        <input type="search" name="client" id="client" value="{{ app.request.query.get('search') }}" placeholder="Rechercher" class="filter filter--text">
        <button type="submit">Rechercher</button>
    </form>
    <select id="newletter" class="filter filter--select">
        <option value="">--Veuillez choisir une option--</option>
        <option value="oui">Oui</option>
        <option value="non">Non</option>
    </select>
    <select id="loyalty" class="filter filter--select">
        <option value="">--Veuillez choisir une option--</option>
        <option value="Nouveau">Nouveau</option>
        <option value="À developper">À développer</option>
        <option value="Client régulier">Client régulier</option>
        <option value="Client fidèle">Client fidèle</option>
    </select>
    <select id="city" class="filter filter--select">
        <option value="">--Veuillez choisir une option--</option>
        <option value="oui">Nantes</option>
        <option value="non">Strasbourg</option>
    </select>
    <p class="btn">
        <img src="" class="icon" alt="Icône"/>
        Filtres
    </p>
    <div class="wrapper">
        <p>Autres filtres</p>
        <p>Autres filtres</p>
        <p>Autres filtres</p>
        <p>Autres filtres</p>
    </div>
    <p class="link">Réinitialiser</p>
</div>
{% endblock %}

{% block statistics %}
<div class="statistics">
    <figure class="stat">
        <img src="" alt="" class="icon">
        <div class="legend">
            <p class="name">Total des clients</p>
            <p class="number">{{ totalClients }}</p>
            <p class="percent">+{{ newClients }} ce mois</p>
        </div>
    </figure>
    <figure class="stat">
        <img src="" alt="" class="icon">
        <div class="legend">
            <p class="name">Clients fidèles</p>
            <p class="number">{{ loyalClients }}</p>
            <p class="percent">{{ percentClient }} % du total</p>
        </div>
    </figure>
    <figure class="stat">
        <img src="" alt="" class="icon">
        <div class="legend">
            <p class="name">Points émis</p>
            <p class="number">{{ loyalty }}</p>
            <p class="percent">+ {{ thisMonth }} ce mois</p>
        </div>
    </figure>
    <figure class="stat">
        <img src="" alt="" class="icon">
        <div class="legend">
            <p class="name">Total des achats</p>
            <p class="number">{{ totalSales }} €</p>
            <p class="percent">+ {{ salesThisMonth }} € ce mois</p>
        </div>
    </figure>
</div>
{% endblock %}

{% block list %}
<table class="columns">
    <tr class="names">
        <th class="name">Client</th>
        <th class="name">Carte fidélité</th>
        <th class="name">Solde de points</th>
        <th class="name">Dernère commande</th>
        <th class="name">Total des achats</th>
        <th class="name">Newsletter</th>
        <th class="name">Statut</th>
        <th class="name">Actions</th>
        <th class="name"></th>
    </tr>
{% for client in clients %}
    <tr class="line">
        <th class="corps">
            <img src="" alt="" class="icon">
            <div class="part">
                <p class="corps">{{ client.prenom }} {{ client.nom }}</p>
                <p class="corps corps--second">{{ client.email }}</p>
            </div>
        </th>
        <th class="corps">
            <p class="corps">#{{ client.carteFidelite.id }}</p>
        </th>
        <th class="corps">
            <p class="corps">{{ client.carteFidelite.soldePoints }}</p>
        </th>
        <th class="corps">
            <p class="corps">01/01/2000</p>
        </th>
        <th class="corps">2549,87 €</th>
        <th class="corps">
        {% if client.newsletter == 1 %}
            <p class="tag tag--success">Oui</p>
        {% else %}
            <p class="tag tag--error">Non</p>
        {% endif %}
        </th>
        <th class="corps">
        {% if client.statut == 'fidele' %}
            <p class="tag tag--primary">Client fidèle</p>
        {% elseif client.statut == 'regulier' %}
            <p class="tag tag--secondary">Client régulier</p>
        {% elseif client.statut == 'nouveau' %}
            <p class="tag tag--secondary">Nouveau</p>
        {% else %}
            <p class="tag tag--warning">À développer</p>
        {% endif %}
        </th>
        <th class="corps">
            <img src="" alt="" class="icon">
        </th>
        <th class="corps">
            <img src="" alt="" class="icon">
        </th>
    </tr>
{% endfor %} 
</table>
{% endblock %}

