{% extends 'admin.html.twig' %}

{% block title %}Liste des clients{% endblock %}

{% block content %}
<main class="clients">

{% block header %}
<header class="header">
    <div class="left">
        <h1 class="title">Clients</h1>
        <p class="corps corps--little">Gérez et consultez la liste de vos clients.</p>
    </div>
    <div class="btns">
        <a href="{{ path('admin_clients_export') }}" class="btn">
            <img src="{{ asset('img/icons/export.svg') }}" class="icon" alt="Icône d'export"/>
            Exporter
        </a>
        <a href="{{ path('admin_clients_add') }}" class="btn btn--secondary">
            <img src="{{ asset('img/icons/addUser.svg') }}" class="icon" alt="Icône d'ajout d'un utilisateur"/>
            Nouveau client
        </a>
    </div>
</header>
{% endblock %}

{% block filters %}
<form method="get" class="filters">

    <input
        type="search"
        name="search"
        value="{{ app.request.query.get('search') }}"
        placeholder="Nom, prénom, email ..."
        class="filter filter--text"
    >

    <select name="newsletter" class="filter filter--select">
        <option value="">Newsletter</option>
        <option value="oui" {{ app.request.query.get('newsletter') == 'oui' ? 'selected' : '' }}>
            Oui
        </option>
        <option value="non" {{ app.request.query.get('newsletter') == 'non' ? 'selected' : '' }}>
            Non
        </option>
    </select>

    <select name="city" class="filter filter--select">
        <option value="">Ville</option>

        {% for city in cities %}
        <option
            value="{{ city }}"
            {{ app.request.query.get('city') == city ? 'selected' : '' }}
        >
            {{ city }}
        </option>
        {% endfor %}
    </select>

    <select name="limit" class="filter filter--select">
        {% for limit in allowedLimits %}
            <option
                value="{{ limit }}"
                {{ app.request.query.getInt('limit', 10) == limit ? 'selected' : '' }}
            >
                {{ limit }} par page
            </option>
        {% endfor %}
    </select>

    <button type="submit">
        Rechercher
    </button>

    <a href="">
        Réinitialiser
    </a>

</form>
{% endblock %}

{% block statistics %}
<div class="statistics">
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/users.svg') }}" alt="Icône d'utilisateur" class="icon">
        </span>
        <div class="legend">
            <p class="name">Total des clients</p>
            <p class="number">{{ totalClients }}</p>
            <p class="percent">+{{ newClients }} ce mois</p>
        </div>
    </figure>
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/star.svg') }}" alt="Icône d'une étoile" class="icon">
        </span>
        <div class="legend">
            <p class="name">Clients fidèles</p>
            <p class="number">{{ loyalClients }}</p>
            <p class="percent">{{ percentClient|number_format(2, ',', ' ') }} % du total</p>
    </figure>
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/gift.svg') }}" alt="Icône d'un cadeau" class="icon">
        </span>
        <div class="legend">
            <p class="name">Points émis</p>
            <p class="number">{{ loyalty }}</p>
            <p class="percent">+ {{ thisMonth|number_format(2, ',', ' ') }} ce mois</p>
        </div>
    </figure>
    <figure class="stat">
        <span class="icon__container">
            <img src="{{ asset('img/icons/calendar.svg') }}" alt="Icône d'un calendrier" class="icon">
        </span>
        <div class="legend">
            <p class="name">Total des achats</p>
            <p class="number">{{ totalSales }} €</p>
            <p class="percent">+ {{ salesThisMonth }} € ce mois</p>
        </div>
    </figure>
</div>
{% endblock %}

{% block list %}
<section class="array__container">
<table class="array">
    <tr class="names">
        <th class="name">Client</th>
        <th class="name">Carte fidélité</th>
        <th class="name">Solde de points</th>
        <th class="name">Dernière commande</th>
        <th class="name">Total des achats</th>
        <th class="name">Newsletter</th>
        <th class="name">Statut</th>
        <th class="name">Actions</th>
        <th class="name"></th>
    </tr>
{% for row in clients %}
    {% set client = row[0] %}
    {% set lastBuy = row.lastBuy %}
    {% set allBuys = row.allBuys %}
    <tr class="line">
        <th class="box identity">
            <p class="initial initial--{{ client.nom|slice(0,1)|lower }}">{{ client.nom|slice(0,1)|upper }}{{ client.prenom|slice(0,1)|upper }}</p>
            <div class="part">
                <p class="corps">{{ client.prenom }} {{ client.nom }}</p>
                <p class="corps corps--second">{{ client.email }}</p>
            </div>
        </th>
        <th class="box">
        {% if client.carteFidelite %}
            <p class="corps">#{{ client.carteFidelite.id }}</p>
        {% else %}
            <p class="corps">-</p>
        {% endif %} 
        </th>
        <th class="box">
        {% if client.carteFidelite %}
            <p class="corps">{{ client.carteFidelite.soldePoints }}</p>
        {% else %}
            <p class="corps">-</p>
        {% endif %}
        </th>
        
        <th class="box">
            <p class="corps">
            {% if allBuys is null %}
                -
            {% else %}
                {{ allBuys|number_format(2, '.', '') }} €
            {% endif %}
            </p>
        </th>
        <th class="box">
        
            <p class="corps">
            {% if lastBuy is null %}
                -
            {% else %}
                {{ lastBuy|date('d/m/Y') }}
            {% endif %}
            </p> 
        </th>
        <th class="box">
        {% if client.newsletter == 1 %}
            <p class="tag tag--success">Oui</p>
        {% else %}
            <p class="tag tag--error">Non</p>
        {% endif %}
        </th>
        <th class="box">
        {% if client.statut == 'fidele' %}
            <p class="tag tag--primary">Client fidèle</p>
        {% elseif client.statut == 'regulier' %}
            <p class="tag tag--secondary">Client régulier</p>
        {% elseif client.statut == 'nouveau' %}
            <p class="tag tag--secondary">Nouveau</p>
        {% else %}
            <p class="tag tag--warning">À développer</p>
        {% endif %}
        </th>
        <th class="box box--icon">
            <a href="{{ path('admin_clients_view', {id: client.id}) }}" class="link">
                <img src="{{ asset('img/icons/eye.svg') }}" alt="Voir plus" class="icon">
            </a>
            <div href="" class="part">
                <img src="{{ asset('img/icons/etc.svg') }}" alt="Actions rapides" class="icon">
                <div class="actions">
                    <a href="{{ path('admin_clients_update', {id: client.id}) }}" class="action corps">Modifier <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M15.4998 5.49994L18.3282 8.32837M3 20.9997L3.04745 20.6675C3.21536 19.4922 3.29932 18.9045 3.49029 18.3558C3.65975 17.8689 3.89124 17.4059 4.17906 16.9783C4.50341 16.4963 4.92319 16.0765 5.76274 15.237L17.4107 3.58896C18.1918 2.80791 19.4581 2.80791 20.2392 3.58896C21.0202 4.37001 21.0202 5.63634 20.2392 6.41739L8.37744 18.2791C7.61579 19.0408 7.23497 19.4216 6.8012 19.7244C6.41618 19.9932 6.00093 20.2159 5.56398 20.3879C5.07171 20.5817 4.54375 20.6882 3.48793 20.9012L3 20.9997Z" stroke="#000000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg></a>
                    <a href="{{ path('admin_clients_delete', {id: client.id})}}" class="action corps"></a>
                    <form 
                        method="post" 
                        action="{{ path('admin_clients_delete', {id: client.id}) }}"
                        onsubmit="return confirm('Voulez-vous vraiment suprrimer ce client ?');" 
                    ">
                        <input 
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('delete' ~ client.id) }}"/>
                        <button type="submit">Supprimer <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M1.5 3.75C1.08579 3.75 0.75 4.08579 0.75 4.5C0.75 4.91421 1.08579 5.25 1.5 5.25V3.75ZM22.5 5.25C22.9142 5.25 23.25 4.91421 23.25 4.5C23.25 4.08579 22.9142 3.75 22.5 3.75V5.25ZM1.5 5.25H22.5V3.75H1.5V5.25Z" fill="#000000"></path> <path d="M9.75 1.5V0.75V1.5ZM8.25 3H7.5H8.25ZM7.5 4.5C7.5 4.91421 7.83579 5.25 8.25 5.25C8.66421 5.25 9 4.91421 9 4.5H7.5ZM15 4.5C15 4.91421 15.3358 5.25 15.75 5.25C16.1642 5.25 16.5 4.91421 16.5 4.5H15ZM15.75 3H16.5H15.75ZM14.25 0.75H9.75V2.25H14.25V0.75ZM9.75 0.75C9.15326 0.75 8.58097 0.987053 8.15901 1.40901L9.21967 2.46967C9.36032 2.32902 9.55109 2.25 9.75 2.25V0.75ZM8.15901 1.40901C7.73705 1.83097 7.5 2.40326 7.5 3H9C9 2.80109 9.07902 2.61032 9.21967 2.46967L8.15901 1.40901ZM7.5 3V4.5H9V3H7.5ZM16.5 4.5V3H15V4.5H16.5ZM16.5 3C16.5 2.40326 16.2629 1.83097 15.841 1.40901L14.7803 2.46967C14.921 2.61032 15 2.80109 15 3H16.5ZM15.841 1.40901C15.419 0.987053 14.8467 0.75 14.25 0.75V2.25C14.4489 2.25 14.6397 2.32902 14.7803 2.46967L15.841 1.40901Z" fill="#000000"></path> <path d="M9 17.25C9 17.6642 9.33579 18 9.75 18C10.1642 18 10.5 17.6642 10.5 17.25H9ZM10.5 9.75C10.5 9.33579 10.1642 9 9.75 9C9.33579 9 9 9.33579 9 9.75H10.5ZM10.5 17.25V9.75H9V17.25H10.5Z" fill="#000000"></path> <path d="M13.5 17.25C13.5 17.6642 13.8358 18 14.25 18C14.6642 18 15 17.6642 15 17.25H13.5ZM15 9.75C15 9.33579 14.6642 9 14.25 9C13.8358 9 13.5 9.33579 13.5 9.75H15ZM15 17.25V9.75H13.5V17.25H15Z" fill="#000000"></path> <path d="M18.865 21.124L18.1176 21.0617L18.1176 21.062L18.865 21.124ZM17.37 22.5L17.3701 21.75H17.37V22.5ZM6.631 22.5V21.75H6.63093L6.631 22.5ZM5.136 21.124L5.88343 21.062L5.88341 21.0617L5.136 21.124ZM4.49741 4.43769C4.46299 4.0249 4.10047 3.71818 3.68769 3.75259C3.2749 3.78701 2.96818 4.14953 3.00259 4.56231L4.49741 4.43769ZM20.9974 4.56227C21.0318 4.14949 20.7251 3.78698 20.3123 3.75259C19.8995 3.7182 19.537 4.02495 19.5026 4.43773L20.9974 4.56227ZM18.1176 21.062C18.102 21.2495 18.0165 21.4244 17.878 21.5518L18.8939 22.6555C19.3093 22.2732 19.5658 21.7486 19.6124 21.186L18.1176 21.062ZM17.878 21.5518C17.7396 21.6793 17.5583 21.75 17.3701 21.75L17.3699 23.25C17.9345 23.25 18.4785 23.0379 18.8939 22.6555L17.878 21.5518ZM17.37 21.75H6.631V23.25H17.37V21.75ZM6.63093 21.75C6.44274 21.75 6.26142 21.6793 6.12295 21.5518L5.10713 22.6555C5.52253 23.0379 6.06649 23.25 6.63107 23.25L6.63093 21.75ZM6.12295 21.5518C5.98449 21.4244 5.89899 21.2495 5.88343 21.062L4.38857 21.186C4.43524 21.7486 4.69172 22.2732 5.10713 22.6555L6.12295 21.5518ZM5.88341 21.0617L4.49741 4.43769L3.00259 4.56231L4.38859 21.1863L5.88341 21.0617ZM19.5026 4.43773L18.1176 21.0617L19.6124 21.1863L20.9974 4.56227L19.5026 4.43773Z" fill="#000000"></path> </g></svg></button>
                    </form>
                </div>
            </div>
        </th>
    </tr>
{% endfor %} 
</table>
</section>
{% endblock %}

{% block pagination %}
{% set totalItems = clients.getTotalItemCount %}

{% if (clients.getCurrentPageNumber() * pageLimit) >= totalItems %}
   {% set maxItem = totalItems %}
{% else %}
    {% set maxItem = clients.getCurrentPageNumber() * pageLimit %}
{% endif %}

<div class="pagination">
    <p class="corps">Affichage {{ (clients.getCurrentPageNumber - 1) * pageLimit }} à {{ maxItem }} sur {{ (totalItems / pageLimit)|round(0, 'ceil') }} pages</p>
    {{ knp_pagination_render(clients) }}
</div>
{% endblock %}

</main>
{% endblock %}
