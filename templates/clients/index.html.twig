<form method="get">
<select name="limit" id="limit" class="filter filter--select">
    {% for limit in allowedLimits %}
        <option
            value="{{ limit }}"
            {{ app.request.query.getInt('limit', 10) == limit ? 'selected' : '' }}
        >
            {{ limit }}
        </option>
    {% endfor %}
