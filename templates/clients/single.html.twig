{% extends 'admin.html.twig' %}

{% block title %}Profil de {{ client.prenom }} {{ client.nom }}{% endblock %}

{% block nav %}
        <nav class="menu">
            <p class="name">Liste des clients</p>
            {% for client in clients %}
                <div class="item">
                    <p class="initial">{{ client.prenom|slice(0,1)|upper }}{{ client.nom|slice(0,1)|upper }}</p>
                    <div>
                        <p class="identity">{{ client.prenom }} {{ client.nom }}</p>
                        <p>#{{ client.id }}</p>
                    </div>
                    <p class="corps">{{ client.points }} pts</p>
                </div>
            {% endfor %}
            <a href="">Voir tous les clients</a>
        </nav>
{% endblock %}

{% block content %}
<p class="initials">{{ client.prenom|slice(0,1)|upper }}{{ client.nom|slice(0,1)|upper }}</p>
<p>{{ client.prenom }} {{ client.nom }}</p>
<p>{{ client.getStatut }}</p>
<p>Client depuis le {{ client.dateCreation|date('d/m/Y') }}</p>
<p>{{ client.email }}</p>
<p>{{ client.telephone }}</p>
<p>Carte de fidélité</p>
<p># {{ client.carteFidelite.id }}</p>
<p>Créée le {{ client.carteFidelite.dateCreation|date('d/m/Y') }}</p>
<p>Solde de points</p>
<p>{{ client.carteFidelite.soldePoints }} pts</p>
<p>Valeur : {{ client.pointValue }} €</p>
<p>Total des achats :</p>
<p>{{ totalSales|number_format(2, ',', ' ') }} €</p>
<p>{{ nbVentesClient }} commandes</p>
<p>Dernière commande</p>
<p>{{ lastSaleDate|date('d / m / Y') }}</p>
<p>Montant : {{ lastSaleAmount|number_format(2) }} €</p>
<br>
<br>
<br>
<br>
<p>Historique des ventes</p>
{% for vente in ventes|slice(0, 6) %}
    ----------------
    <p>{{ vente.date|date('d / m / Y') }}</p>
    <p># {{ vente.id }}</p>
    <p>{{ vente.montantTotal|number_format(2) }} €</p>
    <p>+{{ (vente.montantTotal / 10)|number_format(2) }} pts</p>
{% endfor %}

{% if ventes|length > 6 %}
    Voir toutes les commandes
{% endif %}
<br>
<br>
<br>
<br>
<p>Mouvement de points</p>
{% for mouvement in mouvements|slice(0,5) %}
    ----------------
    <p>
    {% if mouvement.points >= 0 %}
        +
        {% else %}
        -
    {% endif %}
    </p>
    <p>{{ mouvement.date|date('d/m/Y') }}</p>
    <p>{{ mouvement.motif }}</p>
    <p>
    {% if mouvement.points >= 0 %}
        +
        {% else %}
        -
    {% endif %}
    {{ mouvement.points }} pts</p>
{% endfor %}
<br>
<br>
<br>
<br>
<p>Informations client</p>
<br>
<br>
<p>Nom : {{ client.nom }}</p>
<br>
<p>Prénom : {{ client.prenom }}</p>
<br>
<p>Date de naissance : {{ client.dateNaissance|date('d/m/Y') }}</p>
<br>
<p>Téléphone : {{ client.telephone }}</p>
<br>
<p>Email : {{ client.email }}</p>
<br>
<p>Adresse : {{ client.adresse }}</p>
<br>
<p>Complément d'adresse : {{ client.complementAdresse }}</p>
<br>
<p>Ville : {{ client.ville }} ({{ client.codePostal }})</p>
<br>
<p>Pays : {{ client.pays }}</p>
<br>
<p>Newsletter : {% if client.newsletter == 1 %}Oui{% else %}Non{% endif %}</p>
<br>
<p>Date de création : {{ client.dateCreation|date('d/m/Y') }}</p>
<br>
<br>
<br>
<br>
<p>Notes</p>
<br>
<br>
<p>{% if client.notes is not empty %}{{ client.notes }}{% else %}Aucune note attribuée à ce client pour le moment.{% endif %}</p>
{% endblock %}