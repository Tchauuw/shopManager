<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        <link href="{{ asset('css/reset.css') }}" rel="stylesheet"/>

        {# Pages #}
        <link href="{{ asset('css/pages/clients.css') }}" rel="stylesheet"/>
        
        {# Components #}
        <link href="{{ asset('css/components/navbar.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/components/statistics.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/components/header.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/components/filters.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/components/array.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/components/pagination.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/components/adminForm.css') }}" rel="stylesheet"/>

        {# Globals #}
        <link href="{{ asset('css/fonts.css') }}" rel="stylesheet"/>
        <link href="{{ asset('css/global.css') }}" rel="stylesheet"/>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="body">
        {% block body %}{% endblock %}
    </body>
</html>
